KIRBY_NAME="Kirby Starter Kit"
KIRBY_ENV=production
KIRBY_KEY=
KIRBY_INSTALL=false
KIRBY_DEBUG=false
APP_URL=

KIRBY_BLADE_BOOTSTRAP=true
KIRBY_CACHE_PAGES=true
KIRBY_CACHE_TYPE=file
KIRBY_SESSION=kirby_session

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database
DB_USERNAME=username
DB_PASSWORD=secret

# Envío de correo. El remitente debe ser una dirección del propio
# dominio: si se usa la del visitante, SPF/DKIM la rechazan.
MAIL_TYPE=smtp
MAIL_HOST=smtp.ionos.mx
MAIL_PORT=587
MAIL_MAIL=no-reply@framelab.mx
MAIL_AUTH=true
MAIL_USERNAME=no-reply@framelab.mx
MAIL_PASSWORD=""
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="${MAIL_MAIL}"
MAIL_FROM_NAME="${KIRBY_NAME}"

